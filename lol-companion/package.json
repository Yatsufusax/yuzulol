{
  "name": "yuzulol",
  "version": "0.1.0",
  "description": "Segunda pantalla para la selección de campeones de LoL (uso personal)",
  "scripts": {
    "start": "node server/index.js",
    "app": "electron .",
    "build": "electron-builder --win portable --publish never",
    "build:pkg": "npx --yes @yao-pkg/pkg . --targets node20-win-x64 --output YuzuLOL.exe",
    "test": "node --test test/server.test.js"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "bin": "server/index.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "node_modules/qrcode-terminal/vendor/**/*.js"
    ]
  },
  "main": "electron/main.js",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yuzulol.app",
    "productName": "YuzuLOL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server/**/*",
      "public/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "YuzuLOL.exe"
    }
  }
}